            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vehicles"
          }
        },
        {
          "name": "Create Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.vehicle) pm.environment.set('newVehicleId', json.vehicle.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_identification_number\": \"TEST123456789\",\n  \"make\": \"Toyota\",\n  \"model\": \"Vios\",\n  \"year\": 2024,\n  \"license_plate\": \"TST-1234\",\n  \"transmission_type\": \"automatic\",\n  \"fuel_type\": \"petrol\",\n  \"seating_capacity\": 5,\n  \"daily_rate\": 1500.00,\n  \"hourly_late_fee\": 150.00\n}"
            },
            "url": "{{baseUrl}}/api/vehicles"
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_rate\": 1600.00,\n  \"color\": \"Silver\"\n}"
            },
            "url": "{{baseUrl}}/api/vehicles/{{newVehicleId}}"
          }
        },
        {
          "name": "Update Vehicle Status",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{adminToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            },
            "url": "{{baseUrl}}/api/vehicles/{{newVehicleId}}/status"
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": "{{baseUrl}}/api/vehicles/{{newVehicleId}}"
          }
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}/availability?pickup_date=2025-11-01&dropoff_date=2025-11-05",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}", "availability"],
