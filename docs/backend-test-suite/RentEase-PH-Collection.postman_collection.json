			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Register Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('customer_token', response.data.token);",
									"    pm.environment.set('customer_id', response.data.user.id);",
									"    pm.environment.set('customer_email', response.data.user.email);",
									"}",
									"",
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has token', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.data).to.have.property('token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Customer\",\n  \"phone_number\": \"+639123456789\",\n  \"role\": \"customer\"\n}"
